{
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mihaly-farkas/copier-template-github-action-typescript.git"
  },
  "type": "module",
  "engines": {
    "node": ">= 24.0.0"
  },
  "main": "index.mts",
  "scripts": {
    "clean": "npx gts clean",
    "check": "npx gts check '*.mts' 'spec/**/*.mts'",
    "fix": "npx gts fix '*.mts' 'spec/**/*.mts'",
    "test": "npx vitest run",
    "dependency-management:show-major-updates": "npx npm-check-updates",
    "dependency-management:show-minor-updates": "npx npm-check-updates --target semver",
    "dependency-management:update-minor-dependencies": "npx npm-check-updates --target minor --upgrade && npm install",
    "dev-workflow": "npm run clean && npm run fix && npm run test"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "gts": "7.0.0",
    "npm-check-updates": "23.1.0",
    "rimraf": "6.1.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  }
}
