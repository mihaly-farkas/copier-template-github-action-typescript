{
  "extends": "./node_modules/gts/tsconfig-google.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "build",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "spec/**/*.mts",
    "*.mts"
  ],
  "exclude": [
    ".local",
    ".tmp",
    "node_modules"
  ]
}
